# Salin ke .env lalu isi. JANGAN commit .env.
APP_ENV=production

# Wajib diganti. Buat dengan: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=1440

# Akun admin dibuat otomatis saat start pertama kalau belum ada
ADMIN_EMAIL=admin@bebas.stei.site
ADMIN_PASSWORD=ganti-password-admin

DB_PATH=/app/data/bebas.db

# Adapter eksternal. EXTERNAL_APIS=off -> selalu pakai cadangan jarak garis lurus, tanpa cuaca
EXTERNAL_APIS=on
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT=4

# Pisahkan dengan koma. * = semua origin
CORS_ORIGINS=*

# Cloudflare Tunnel sebagai kontainer (opsional, lihat README bagian Deploy).
# Kosongkan dua baris ini kalau cloudflared sudah berjalan sebagai service sistem di STB.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=token-dari-dashboard-cloudflare

# Identitas klien saat memanggil API publik (Open-Meteo, OSRM)
USER_AGENT=TugasBesar-TST/1.0 (kelompok-bebas)
# Batas pemanggilan per API key kelompok lain
API_KEY_RATE_PER_MIN=120
